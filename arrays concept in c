1️⃣ Read and Display Array Elements

#include <stdio.h>
int main() {
    int n, i, arr[100];
    printf("Enter number of elements: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Array elements are:\n");
    for(i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    return 0;
}

2️⃣ Find Sum and Average of Array Elements

#include <stdio.h>
int main() {
    int n, i, arr[50], sum = 0;
    float avg;
    scanf("%d", &n);

    for(i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
        sum += arr[i];
    }

    avg = (float)sum / n;
    printf("Sum = %d, Average = %.2f", sum, avg);
    return 0;
}

3️⃣ Find Maximum and Minimum in Array

#include <stdio.h>
int main() {
    int n, i, max, min, arr[100];
    scanf("%d", &n);

    for(i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    max = min = arr[0];
    for(i = 1; i < n; i++) {
        if(arr[i] > max) max = arr[i];
        if(arr[i] < min) min = arr[i];
    }

    printf("Max = %d, Min = %d", max, min);
    return 0;
}

4️⃣ Reverse an Array

#include <stdio.h>
int main() {
    int n, arr[100];
    scanf("%d", &n);
    for(int i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    printf("Reversed array:\n");
    for(int i = n - 1; i >= 0; i--)
        printf("%d ", arr[i]);
    return 0;
}

5️⃣ Search an Element (Linear Search)

#include <stdio.h>
int main() {
    int n, arr[100], key, found = 0;
    scanf("%d", &n);
    for(int i = 0; i < n; i++)
        scanf("%d", &arr[i]);
    scanf("%d", &key);

    for(int i = 0; i < n; i++) {
        if(arr[i] == key) {
            found = 1;
            printf("Element found at position %d", i + 1);
            break;
        }
    }
    if(!found) printf("Element not found");
    return 0;
}

6️⃣ Sort an Array (Ascending Order)

#include <stdio.h>
int main() {
    int n, arr[100], i, j, temp;
    scanf("%d", &n);
    for(i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    for(i = 0; i < n - 1; i++) {
        for(j = i + 1; j < n; j++) {
            if(arr[i] > arr[j]) {
                temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
        }
    }

    printf("Sorted array:\n");
    for(i = 0; i < n; i++)
        printf("%d ", arr[i]);
    return 0;
}

7️⃣ Merge Two Arrays

#include <stdio.h>
int main() {
    int n1, n2, a[50], b[50], c[100], i, j;
    scanf("%d", &n1);
    for(i = 0; i < n1; i++) scanf("%d", &a[i]);
    scanf("%d", &n2);
    for(i = 0; i < n2; i++) scanf("%d", &b[i]);

    for(i = 0; i < n1; i++) c[i] = a[i];
    for(j = 0; j < n2; j++) c[n1 + j] = b[j];

    printf("Merged array:\n");
    for(i = 0; i < n1 + n2; i++) printf("%d ", c[i]);
    return 0;
}

8️⃣ Copy Array Elements to Another Array

#include <stdio.h>
int main() {
    int n, a[50], b[50];
