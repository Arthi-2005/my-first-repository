1️⃣ Read and Display a String

#include <stdio.h>
int main() {
    char str[100];
    printf("Enter a string: ");
    gets(str);  // or use fgets(str, 100, stdin);
    printf("You entered: %s", str);
    return 0;
}

2️⃣ Find Length of a String (without using library)

#include <stdio.h>
int main() {
    char str[100];
    int i, len = 0;
    gets(str);

    for(i = 0; str[i] != '\0'; i++)
        len++;

    printf("Length of string = %d", len);
    return 0;
}

3️⃣ Copy One String to Another

#include <stdio.h>
int main() {
    char str1[100], str2[100];
    int i;
    gets(str1);

    for(i = 0; str1[i] != '\0'; i++)
        str2[i] = str1[i];
    str2[i] = '\0';

    printf("Copied string: %s", str2);
    return 0;
}

4️⃣ Compare Two Strings (without using strcmp)

#include <stdio.h>
int main() {
    char s1[100], s2[100];
    int i, flag = 0;
    gets(s1);
    gets(s2);

    for(i = 0; s1[i] != '\0' || s2[i] != '\0'; i++) {
        if(s1[i] != s2[i]) {
            flag = 1;
            break;
        }
    }

    if(flag == 0)
        printf("Strings are equal");
    else
        printf("Strings are not equal");
    return 0;
}

5️⃣ Concatenate (Join) Two Strings

#include <stdio.h>
int main() {
    char s1[100], s2[100];
    int i = 0, j = 0;
    gets(s1);
    gets(s2);

    while(s1[i] != '\0') i++;
    while(s2[j] != '\0') {
        s1[i++] = s2[j++];
    }
    s1[i] = '\0';

    printf("Concatenated string: %s", s1);
    return 0;
}

6️⃣ Check if String is Palindrome

#include <stdio.h>
#include <string.h>
int main() {
    char str[100];
    int i, len, flag = 0;
    gets(str);
    len = strlen(str);

    for(i = 0; i < len / 2; i++) {
        if(str[i] != str[len - i - 1]) {
            flag = 1;
            break;
        }
    }

    if(flag == 0)
        printf("Palindrome");
    else
        printf("Not Palindrome");
    return 0;
}

7️⃣ Count Vowels and Consonants

#include <stdio.h>
int main() {
    char str[100];
    int i, v = 0, c = 0;
    gets(str);

    for(i = 0; str[i] != '\0'; i++) {
        if((str[i]>='a'&&str[i]<='z') || (str[i]>='A'&&str[i]<='Z')) {
            char ch = tolower(str[i]);
            if(ch=='a'||ch=='e'||ch=='i'||ch=='o'||ch=='u')
                v++;
            else
                c++;
        }
    }

    printf("Vowels = %d, Consonants = %d", v, c);
    return 0;
}

8️⃣ Count Words in a String

#include <stdio.h>
int main() {
    char str[200];
    int i, count = 1;
    gets(str);

    for(i = 0; str[i] != '\0'; i++) {
        if(str[i] == ' ' && str[i+1] != ' ' && str[i+1] != '\0')
            count++;
    }

    printf("Word count = %d", count);
    return 0;
}

9️⃣ Convert String to Uppercase

#include <stdio.h>
int main() {
    char str[100];
    int i;
    gets(str);

    for(i = 0; str[i] != '\0'; i++) {
        if(str[i] >= 'a' && str[i] <= 'z')
            str[i] -= 32;
    }

    printf("Uppercase: %s", str);
    return 0;
}

🔟 Reverse a String

#include <stdio.h>
#include <string.h>
int main() {
    char str[100], rev[100];
    int i, j = 0;
    gets(str);

    for(i = strlen(str) - 1; i >= 0; i--)
        rev[j++] = str[i];
    rev[j] = '\0';

    printf("Reversed string: %s", rev);
    return 0;
}
